# IA — formato provedor:modelo; provedores: anthropic | openai-compat | fake
IA_ROTULO=anthropic:claude-opus-5-5
IA_PRATO=anthropic:claude-opus-5-5
# anthropic | api-busca | nenhuma | fake
# O padrão (anthropic) exige ANTHROPIC_API_KEY mesmo quando IA_ROTULO e
# IA_PRATO usam openai-compat.
IA_PRECO_BUSCA=anthropic
# Precisa ser um modelo Claude com suporte à ferramenta web_search_20260209.
IA_PRECO_MODELO=claude-opus-5-5
ANTHROPIC_API_KEY=
# omnirouter, OpenRouter, LiteLLM ou outro endpoint compatível com a API da OpenAI
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_JSON_SCHEMA=true
OPENAI_COMPAT_SUPORTA_IMAGEM=true
# só com IA_PRECO_BUSCA=api-busca
TAVILY_API_KEY=
